    "@dcloudio/uni-mp-qq": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-toutiao": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-xhs": "3.0.0-5020420260813003",
    "@dcloudio/uni-quickapp-webview": "3.0.0-5020420260813003",
    "@prisma/client": "^6.19.3",
    "pinia": "^2.3.0",
    "vue": "^3.4.21",
    "vue-i18n": "^9.1.9"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
