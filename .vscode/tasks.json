{
  "version": "2.0.0",
  "tasks": [
    { "label": "Verify: affected", "type": "shell", "command": "npm run verify:affected", "options": { "cwd": "${workspaceFolder}" }, "group": "test", "problemMatcher": [] },
    { "label": "Verify: passenger", "type": "shell", "command": "npm run verify:passenger", "options": { "cwd": "${workspaceFolder}" }, "group": "build", "problemMatcher": [] },
    { "label": "Verify: API", "type": "shell", "command": "npm run verify:api", "options": { "cwd": "${workspaceFolder}" }, "group": "build", "problemMatcher": ["$tsc"] },
    { "label": "Verify: admin", "type": "shell", "command": "npm run verify:admin", "options": { "cwd": "${workspaceFolder}" }, "group": "build", "problemMatcher": [] },
    { "label": "Verify: driver", "type": "shell", "command": "npm run verify:driver", "options": { "cwd": "${workspaceFolder}" }, "group": "test", "problemMatcher": [] },
    { "label": "Start: driver (8085)", "type": "shell", "command": "flutter run -d web-server --web-hostname 127.0.0.1 --web-port 8085", "options": { "cwd": "${workspaceFolder}/driver" }, "isBackground": true, "inAgents": true, "problemMatcher": [] },
    { "label": "Verify: brand", "type": "shell", "command": "npm run verify:brand", "options": { "cwd": "${workspaceFolder}" }, "group": "build", "problemMatcher": [] },
    { "label": "Check: scope", "type": "shell", "command": "npm run check:scope -- --scope ${input:checkScopeArea} ${input:checkScopeMode}", "options": { "cwd": "${workspaceFolder}" }, "group": "test", "problemMatcher": [] },
    { "label": "Check: dependencies", "type": "shell", "command": "npm run check:dependencies", "options": { "cwd": "${workspaceFolder}" }, "group": "test", "problemMatcher": [] },
    { "label": "Check: admin style boundaries", "type": "shell", "command": "npm run check:admin-style-boundaries", "options": { "cwd": "${workspaceFolder}" }, "group": "test", "problemMatcher": [] },
    { "label": "Check: conflict markers", "type": "shell", "command": "npm run check:conflict-markers", "options": { "cwd": "${workspaceFolder}" }, "group": "test", "problemMatcher": [] }
  ],
  "inputs": [
    { "id": "checkScopeArea", "type": "pickString", "description": "Scope to check", "options": ["passenger", "api", "admin", "driver", "brand", "cross-cutting"], "default": "cross-cutting" },
    { "id": "checkScopeMode", "type": "pickString", "description": "Files to check", "options": [{ "label": "Working tree (uncommitted + untracked)", "value": "" }, { "label": "Staged only", "value": "--staged" }], "default": "" }
  ]
}
