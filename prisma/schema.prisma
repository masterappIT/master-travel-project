generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  countryCode        String              @default("+852")
  phoneNumber        String
  name               String?
  cashBalance        Float               @default(0)
  fareBalance        Float               @default(0)
  membershipLevel    String?
  createdAt          DateTime            @default(now())
  trips              Trip[]
  walletTransactions WalletTransaction[]

  @@unique([countryCode, phoneNumber])
}

model WalletTransaction {
  id              String                @id @default(cuid())
  userId          String
  wallet          WalletType
  type            WalletTransactionType
  amount          Float
  balanceAfter    Float
  reason          String
  administratorId String?
  createdAt       DateTime              @default(now())
  user            User                  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

enum WalletType {
  CASH
  FARE
}

enum WalletTransactionType {
  ADMIN_INCREASE
  ADMIN_DECREASE
  TOP_UP
  WITHDRAWAL
}

model Trip {
  id          String     @id @default(cuid())
  userId      String
  origin      String
  destination String
  region      Region
  scheduledAt DateTime
  status      TripStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([scheduledAt])
}

enum Region {
  HK
  MACAU
  GUANGDONG
}

enum TripStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model AppSetting {
  id           String   @id
  language     String
  region       String
  currency     String
  exchangeRate Float
  adminLogo    String?  @db.Text
  updatedAt    DateTime @updatedAt
}

model RecommendedAddress {
  id        String   @id @default(cuid())
  region    String
  city      String?
  name      String
  address   String
  latitude  Float?
  longitude Float?
  enabled   Boolean  @default(true)
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, order])
}

model MainlandCity {
  id        String   @id @default(cuid())
  name      String   @unique
  enabled   Boolean  @default(true)
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, order])
}

model VehicleCategory {
  id                String                   @id
  name              String
  tabLabel          String
  order             Int
  enabled           Boolean                  @default(true)
  vehicles          Vehicle[]
  distancePricing   CategoryDistancePricing?
  routeMinimumFares RouteMinimumFare[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([enabled, order])
}

model RouteMinimumFare {
  id                String           @id @default(cuid())
  originRegion      String
  originCity        String?
  destinationRegion String
  destinationCity   String?
  categoryId        String?
  minimumFare       Float
  currency          String
  enabled           Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  category          VehicleCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([originRegion, originCity, destinationRegion, destinationCity, enabled])
  @@index([categoryId, enabled])
}

model Vehicle {
  id               String           @id
  categoryId       String?
  brand            String
  model            String
  series           String
  seats            Int
  image            String
  colorLabel       String
  modelChoiceLabel String
  enabled          Boolean          @default(true)
  order            Int
  category         VehicleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([categoryId])
  @@index([enabled, order])
}

model CategoryDistancePricing {
  id          String                @id @default(cuid())
  categoryId  String                @unique
  minimumFare Float
  currency    String
  category    VehicleCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tiers       DistancePricingTier[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model DistancePricingTier {
  id         String                  @id
  pricingId  String
  fromKm     Float
  toKm       Float?
  pricePerKm Float
  order      Int
  pricing    CategoryDistancePricing @relation(fields: [pricingId], references: [id], onDelete: Cascade)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@unique([pricingId, order])
  @@index([pricingId, order])
}

model VehicleExtra {
  id        String   @id
  name      String
  label     String
  price     Float
  currency  String
  enabled   Boolean  @default(true)
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, order])
}

model FareQuote {
  id              String                    @id @default(cuid())
  distanceKm      Float
  currency        String
  subtotal        Float
  total           Float
  expiresAt       DateTime?
  createdAt       DateTime                  @default(now())
  pricing         FareQuotePricingSnapshot?
  vehicle         FareQuoteVehicleSnapshot?
  lines           FareQuoteLine[]
  promotionUsages PromotionUsage[]
}

model FareQuotePricingSnapshot {
  id                     String                  @id @default(cuid())
  quoteId                String                  @unique
  categoryId             String
  categoryName           String
  tabLabel               String
  minimumFare            Float
  routeMinimumFare       Float?
  routeOriginRegion      String?
  routeOriginCity        String?
  routeDestinationRegion String?
  routeDestinationCity   String?
  currency               String
  quote                  FareQuote               @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  tiers                  FareQuoteTierSnapshot[]
  createdAt              DateTime                @default(now())
}

model FareQuoteTierSnapshot {
  id           String                   @id @default(cuid())
  snapshotId   String
  sourceTierId String
  fromKm       Float
  toKm         Float?
  pricePerKm   Float
  order        Int
  snapshot     FareQuotePricingSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, order])
}

model FareQuoteVehicleSnapshot {
  id               String    @id @default(cuid())
  quoteId          String    @unique
  vehicleId        String
  categoryId       String?
  brand            String
  model            String
  series           String
  seats            Int
  image            String
  colorLabel       String
  modelChoiceLabel String
  quote            FareQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
}

model FareQuoteLine {
  id          String            @id @default(cuid())
  quoteId     String
  type        FareQuoteLineType
  sourceId    String?
  label       String
  quantity    Float
  unitAmount  Float
  totalAmount Float
  currency    String
  order       Int
  quote       FareQuote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())

  @@unique([quoteId, order])
}

enum FareQuoteLineType {
  MINIMUM_FARE
  DISTANCE_TIER
  VEHICLE
  EXTRA
  ADJUSTMENT
  DISCOUNT
}

model Promotion {
  id                String                @id @default(cuid())
  name              String
  kind              PromotionKind
  discountType      DiscountType
  stackingMode      PromotionStackingMode @default(NONE)
  discountValue     Float
  currency          String                @default("RMB¥")
  minimumSpend      Float                 @default(0)
  maximumDiscount   Float?
  priority          Int                   @default(0)
  startsAt          DateTime?
  endsAt            DateTime?
  enabled           Boolean               @default(true)
  couponCode        String?               @unique
  usageLimit        Int?
  usageCount        Int                   @default(0)
  membershipLevel   String?
  originRegion      String?
  originCity        String?
  destinationRegion String?
  destinationCity   String?
  weekdays          Json?
  timeStart         String?
  timeEnd           String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  usages            PromotionUsage[]

  @@index([kind, enabled, startsAt, endsAt])
}

model PromotionUsage {
  id          String               @id @default(cuid())
  promotionId String
  quoteId     String
  status      PromotionUsageStatus @default(RESERVED)
  createdAt   DateTime             @default(now())
  usedAt      DateTime?
  releasedAt  DateTime?
  promotion   Promotion            @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  quote       FareQuote            @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([promotionId, quoteId])
  @@index([promotionId, status])
}

enum PromotionUsageStatus {
  RESERVED
  USED
  RELEASED
}

enum PromotionKind {
  CAMPAIGN
  COUPON
  MEMBER
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  TOTAL_PRICE
}

enum PromotionStackingMode {
  NONE
  PERCENTAGE_AND_VOUCHER
  ALL
}
