generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Notification {
  id           String    @id @default(cuid())
  title        String
  content      String    @db.Text
  audience     String
  templateType String?   @default("system")
  important    Boolean   @default(false)
  userId       String?
  driverId     String?
  readAt       DateTime?
  createdAt    DateTime  @default(now())
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  driver       Driver?   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([driverId, readAt, createdAt])
  @@index([audience, createdAt])
  @@index([important, createdAt])
}

model NotificationTemplate {
  id           String   @id @default(cuid())
  name         String
  type         String
  title        String
  content      String   @db.Text
  audience     String   @default("ALL_USERS")
  important    Boolean  @default(false)
  enabled      Boolean  @default(true)
  builtIn      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type, enabled])
}


model User {
  id                 String              @id
  countryCode        String              @default("+852")
  phoneNumber        String
  name               String?
  displayName        String?
  avatarUrl          String?
  avatarData         Bytes?
  avatarMimeType     String?
  email              String?
  passwordHash       String?
  gender             String?
  region             String?
  birthday           DateTime?
  cashBalance        Float               @default(0)
  fareBalance        Float               @default(0)
  membershipLevel    String?
  lastLoginAt        DateTime?
  lastLogoutAt       DateTime?
  createdAt          DateTime            @default(now())
  enabled            Boolean             @default(true)
  trips              Trip[]
  walletTransactions WalletTransaction[]
  payments           Payment[]
  authIdentities     AuthIdentity[]
  clientSessions     ClientSession[]
  verificationCodes  VerificationCode[]
  notifications      Notification[]
  commonPassengers   CommonPassenger[]

  @@unique([countryCode, phoneNumber])
}

model CommonPassenger {
  id              String   @id @default(cuid())
  userId          String
  name            String
  phone           String
  phoneRegion     String
  gender          String
  documentType    String
  passportCountry String?
  isDefault       Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sortOrder])
  @@index([userId, isDefault])
}

model ClientSession {
  id        String    @id @default(cuid())
  jti       String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}
model AuthIdentity {
  id         String   @id @default(cuid())
  provider   String
  providerId String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([provider, providerId])
  @@unique([provider, userId])
  @@index([userId])
}

model VerificationCode {
  id           String    @id @default(cuid())
  userId       String?
  countryCode  String
  phoneNumber  String
  purpose      String    @default("LOGIN")
  status       String    @default("ISSUED")
  codeHash     String
  attempts     Int       @default(0)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([countryCode, phoneNumber, createdAt])
  @@index([status, expiresAt])
}

model WalletTransaction {
  id              String                @id @default(cuid())
  userId          String
  wallet          WalletType
  type            WalletTransactionType
  amount          Float
  balanceAfter    Float
  reason          String
  administratorId String?
  paymentId       String?
  createdAt       DateTime              @default(now())
  user            User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  payment         Payment?              @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([paymentId])
}

enum WalletType {
  CASH
  FARE
}

enum WalletTransactionType {
  ADMIN_INCREASE
  ADMIN_DECREASE
  TOP_UP
  WITHDRAWAL
  TRIP_PAYMENT
  REFUND
}

model Trip {
  id                    String              @id @default(cuid())
  userId                String
  quoteId               String?             @unique
  origin                String
  destination           String
  region                Region
  scheduledAt           DateTime
  passengerName         String?
  passengerPhone        String?
  passengerPhoneRegion  String?
  passengerGender       String?
  passengerDocumentType String?
  passengerPassportCountry String?
  estimatedArrivalAt    DateTime?
  status                TripStatus          @default(PENDING)
  executionPhase        TripExecutionPhase?
  driverId              String?
  driverName            String?
  driverPhone           String?
  vehiclePlate          String?
  assignedAt            DateTime?
  acceptedAt            DateTime?
  arrivedAt             DateTime?
  startedAt             DateTime?
  completedAt           DateTime?
  fareBalancePaid       Float               @default(0)
  cashBalancePaid       Float               @default(0)
  externalPaid          Float               @default(0)
  externalPaymentMethod String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  user                  User                @relation(fields: [userId], references: [id])
  driver                Driver?             @relation(fields: [driverId], references: [id], onDelete: SetNull)
  orderUrls             TripOrderUrl[]
  payment               Payment?
  settlement            DriverSettlement?
  quote                 FareQuote?          @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([scheduledAt])
  @@index([driverId, status])
}

model Payment {
  id                    String              @id @default(cuid())
  tripId                String              @unique
  quoteId               String              @unique
  userId                String
  total                 Float
  currency              String
  fareAmount            Float               @default(0)
  cashAmount            Float               @default(0)
  externalAmount        Float               @default(0)
  externalPaymentMethod String?
  externalReference     String?
  status                PaymentStatus       @default(PAID)
  refundedAt            DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  trip                  Trip                @relation(fields: [tripId], references: [id], onDelete: Restrict)
  user                  User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletTransactions    WalletTransaction[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

enum PaymentStatus {
  PAID
  REFUNDED
}

enum Region {
  HK
  MACAU
  GUANGDONG
}

enum TripStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum TripExecutionPhase {
  WAITING_DRIVER
  DRIVER_ASSIGNED
  IN_PROGRESS
}

model AppSetting {
  id                    String   @id
  language              String
  region                String
  currency              String
  pricingCurrency       String   @default("RMB")
  exchangeRate          Float
  adminLogo             String?  @db.Text
  severeWeatherEnabled  Boolean  @default(false)
  driverRaceEnabled     Boolean  @default(false)
  fareBalancePayEnabled Boolean  @default(true)
  cashBalancePayEnabled Boolean  @default(true)
  wechatPayEnabled      Boolean  @default(true)
  alipayPayEnabled      Boolean  @default(true)
  bankCardPayEnabled    Boolean  @default(true)
  sandboxMode           Boolean  @default(false)
  updatedAt             DateTime @updatedAt
}

model RecommendedAddress {
  id        String   @id @default(cuid())
  region    String
  city      String?
  name      String
  address   String
  latitude  Float?
  longitude Float?
  enabled   Boolean  @default(true)
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, order])
}

model MainlandCity {
  id        String   @id @default(cuid())
  name      String   @unique
  enabled   Boolean  @default(true)
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, order])
}

model VehicleCategory {
  id                String                   @id
  name              String
  tabLabel          String
  order             Int
  enabled           Boolean                  @default(true)
  vehicles          Vehicle[]
  distancePricing   CategoryDistancePricing?
  routeMinimumFares RouteMinimumFare[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([enabled, order])
}

model Driver {
  id                String               @id
  driverType        String               @default("內部司機")
  name              String
  affiliation       String
  plateType         String
  hkPlate           String
  mainlandPlate     String?
  phoneCountryCode  String               @default("+852")
  phone             String
  vehicleCategory   String
  vehicleColor      String
  vehiclePhotos     Json
  reviewStatus      String               @default("待審核")
  settlementMethod  String?
  settlementAccount String?
  isOnline          Boolean              @default(false)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  trips             Trip[]
  settlements       DriverSettlement[]
  onlineSessions    DriverOnlineSession[]
  ratings           DriverRating[]
  authIdentities    DriverAuthIdentity[]
  otpChallenges     DriverOtpChallenge[]
  sessions          DriverSession[]
  notifications     Notification[]
  orderUrls         TripOrderUrl[]

  @@index([reviewStatus])
  @@index([phone])
  @@index([vehicleCategory])
}

model DriverSettlement {
  id              String   @id @default(cuid())
  tripId          String   @unique
  driverId        String
  method          String
  settledAt       DateTime @default(now())
  createdAt       DateTime @default(now())
  trip            Trip     @relation(fields: [tripId], references: [id], onDelete: Restrict)
  driver          Driver   @relation(fields: [driverId], references: [id], onDelete: Restrict)

  @@index([driverId, settledAt])
}

model DriverOnlineSession {
  id        String   @id @default(cuid())
  driverId  String
  startedAt DateTime
  endedAt   DateTime?
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, startedAt])
  @@index([driverId, endedAt])
}

model DriverRating {
  id        String   @id @default(cuid())
  driverId  String
  tripId    String?  @unique
  score     Float
  comment   String?
  createdAt DateTime @default(now())
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, createdAt])
}

model TripOrderUrl {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  tripId     String
  driverId   String?
  validFrom  DateTime
  validUntil DateTime
  usedAt     DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  trip       Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driver     Driver?   @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@index([driverId, validFrom, validUntil])
}

model DriverAuthIdentity {
  id         String   @id @default(cuid())
  provider   String
  providerId String
  driverId   String
  driver     Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([provider, providerId])
  @@unique([provider, driverId])
  @@index([driverId])
}

model DriverOtpChallenge {
  id          String    @id @default(cuid())
  driverId    String?
  countryCode String
  phone       String
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  driver      Driver?   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([phone, expiresAt])
  @@index([driverId, expiresAt])
}

model DriverSession {
  id        String    @id @default(cuid())
  jti       String    @unique
  driverId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  driver    Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, revokedAt])
  @@index([expiresAt])
}

model RouteMinimumFare {
  id                String           @id @default(cuid())
  originRegion      String
  originCity        String?
  destinationRegion String
  destinationCity   String?
  categoryId        String?
  minimumFare       Float
  currency          String
  enabled           Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  category          VehicleCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([originRegion, originCity, destinationRegion, destinationCity, enabled])
  @@index([categoryId, enabled])
}

model Vehicle {
  id               String           @id
  categoryId       String?
  brand            String
  model            String
  series           String
  seats            Int
  image            String
  colorLabel       String
  modelChoiceLabel String
  enabled          Boolean          @default(true)
  order            Int
  category         VehicleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([categoryId])
  @@index([enabled, order])
}

model CategoryDistancePricing {
  id          String                @id @default(cuid())
  categoryId  String                @unique
  minimumFare Float
  currency    String
  category    VehicleCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tiers       DistancePricingTier[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model DistancePricingTier {
  id         String                  @id
  pricingId  String
  fromKm     Float
  toKm       Float?
  pricePerKm Float
  order      Int
  pricing    CategoryDistancePricing @relation(fields: [pricingId], references: [id], onDelete: Cascade)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@unique([pricingId, order])
  @@index([pricingId, order])
}

model VehicleExtra {
  id                    String   @id
  name                  String
  label                 String
  price                 Float
  currency              String
  enabled               Boolean  @default(true)
  order                 Int
  requiredForImmediate  Boolean  @default(false)
  requiredWithinMinutes Int?
  triggerType           String   @default("NONE")
  triggerEnabled        Boolean  @default(true)
  nightStartTime        String?
  nightEndTime          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([enabled, order])
}

model FareQuote {
  id              String                    @id @default(cuid())
  distanceKm      Float
  currency        String
  subtotal        Float
  total           Float
  durationSeconds Float?
  expiresAt       DateTime?
  createdAt       DateTime                  @default(now())
  pricing         FareQuotePricingSnapshot?
  vehicle         FareQuoteVehicleSnapshot?
  lines           FareQuoteLine[]
  promotionUsages PromotionUsage[]
  trip            Trip?
}

model FareQuotePricingSnapshot {
  id                     String                  @id @default(cuid())
  quoteId                String                  @unique
  categoryId             String
  categoryName           String
  tabLabel               String
  minimumFare            Float
  routeMinimumFare       Float?
  routeOriginRegion      String?
  routeOriginCity        String?
  routeDestinationRegion String?
  routeDestinationCity   String?
  currency               String
  quote                  FareQuote               @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  tiers                  FareQuoteTierSnapshot[]
  createdAt              DateTime                @default(now())
}

model FareQuoteTierSnapshot {
  id           String                   @id @default(cuid())
  snapshotId   String
  sourceTierId String
  fromKm       Float
  toKm         Float?
  pricePerKm   Float
  order        Int
  snapshot     FareQuotePricingSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, order])
}

model FareQuoteVehicleSnapshot {
  id               String    @id @default(cuid())
  quoteId          String    @unique
  vehicleId        String
  categoryId       String?
  brand            String
  model            String
  series           String
  seats            Int
  image            String
  colorLabel       String
  modelChoiceLabel String
  quote            FareQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
}

model FareQuoteLine {
  id          String            @id @default(cuid())
  quoteId     String
  type        FareQuoteLineType
  sourceId    String?
  label       String
  quantity    Float
  unitAmount  Float
  totalAmount Float
  currency    String
  order       Int
  quote       FareQuote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())

  @@unique([quoteId, order])
}

enum FareQuoteLineType {
  MINIMUM_FARE
  DISTANCE_TIER
  VEHICLE
  EXTRA
  ADJUSTMENT
  DISCOUNT
}

model Promotion {
  id                String                @id @default(cuid())
  name              String
  kind              PromotionKind
  discountType      DiscountType
  stackingMode      PromotionStackingMode @default(NONE)
  discountValue     Float
  currency          String                @default("RMB")
  minimumSpend      Float                 @default(0)
  maximumDiscount   Float?
  priority          Int                   @default(0)
  startsAt          DateTime?
  endsAt            DateTime?
  enabled           Boolean               @default(true)
  couponCode        String?               @unique
  usageLimit        Int?
  usageCount        Int                   @default(0)
  membershipLevel   String?
  originRegion      String?
  originCity        String?
  destinationRegion String?
  destinationCity   String?
  weekdays          Json?
  timeStart         String?
  timeEnd           String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  usages            PromotionUsage[]

  @@index([kind, enabled, startsAt, endsAt])
}

model PromotionUsage {
  id          String               @id @default(cuid())
  promotionId String
  quoteId     String
  status      PromotionUsageStatus @default(RESERVED)
  createdAt   DateTime             @default(now())
  usedAt      DateTime?
  releasedAt  DateTime?
  promotion   Promotion            @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  quote       FareQuote            @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([promotionId, quoteId])
  @@index([promotionId, status])
}

enum PromotionUsageStatus {
  RESERVED
  USED
  RELEASED
}

enum PromotionKind {
  CAMPAIGN
  COUPON
  MEMBER
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  TOTAL_PRICE
}

enum PromotionStackingMode {
  NONE
  PERCENTAGE_AND_VOUCHER
  ALL
}
